#!/usr/bin/env python3
"""retire -- set paths aside for later deletion, with a ledger and a safety review.

Nothing here deletes anything except `purge`, which requires an explicit --yes and
prints what it is about to remove. `review` is read-only by design: it reports a
verdict and never acts on it.

  retire put <path> [--reason R] [--review-in 90d]   rename aside + record
  retire adopt <retired_path> [--name N] ...         record an already-moved path
  retire list [--all|--due] [--sort K] [--full]      show active pipeline (or full ledger)
  retire review [name ...] [--due] [--notify]        read-only safety check
  retire ack <name>                                  accept current refs as known
  retire rebaseline <name>... | --all                reset the tripwire snapshot
  retire restore <name>                              put it back
  retire purge <name> --yes                          actually delete it
  retire doctor                                      report the local setup

`retire ?`, `retire help [command]` and `man retire` all show documentation.
"""
import argparse, contextlib, fcntl, json, math, os, platform, re, shutil, signal, stat, subprocess, sys, tempfile, time
from datetime import date, datetime, timedelta
from fnmatch import fnmatchcase

for _stream in (sys.stdout, sys.stderr):
    if hasattr(_stream, "reconfigure"):
        try:
            _stream.reconfigure(errors="replace")
        except Exception:
            pass

__version__ = "1.2.0"


def _fspath(p):
    """Ensure a UTF-8 path string is passable to OS/subprocess APIs under ASCII locales."""
    try:
        os.fsencode(p)
        return p
    except UnicodeEncodeError:
        return os.fsdecode(p.encode("utf-8"))

HOME = os.path.expanduser("~")


def _base(env_var, fallback):
    """XDG base dir, falling back under $HOME. macOS has no XDG spec but honours these."""
    return os.environ.get(env_var) or os.path.join(HOME, fallback)


STATE  = os.environ.get("RETIRE_STATE") or os.path.join(
    _base("XDG_DATA_HOME", ".local/share"), "retire")
CONFIG = os.environ.get("RETIRE_CONFIG") or os.path.join(
    _base("XDG_CONFIG_HOME", ".config"), "retire", "config.json")
LEDGER = os.path.join(STATE, "ledger.jsonl")
LOCK   = os.path.join(STATE, "ledger.lock")
LOG    = os.path.join(STATE, "review.log")

DEFAULTS = {
    # Directories to grep when checking whether a retired name is still referenced.
    # Empty by default: with no roots the check reports UNVERIFIED rather than
    # pretending the tree is unreferenced.
    "search_roots": [],
    "includes": ["*.py", "*.ipynb", "*.sh", "*.md", "*.yaml", "*.yml", "*.json",
                 "*.toml", "*.cfg", "*.ini", "*.c", "*.h", "*.go", "*.rs", "*.js",
                 "*.ts", "*.java", "*.rb", "*.R", "*.r", "*.sql", "*.txt"],
    "exclude_dirs": [".git", ".hg", ".svn", "__pycache__", "node_modules",
                     ".ipynb_checkpoints", ".venv", "venv", ".tox", "target"],
    # Optional grace window (in hours) before a newer atime counts as a read.
    # Default 0: file atimes are never bumped by our scan, and directory atimes are
    # floored by their exact post-scandir timestamp. mtime and ctime are always exact.
    "atime_slack_hours": 0,
    "default_review_in": "90d",
}

TS_FIELDS = (("atime", "read"), ("mtime", "contents modified"), ("ctime", "metadata changed"))


def _parse_span(s):
    m = re.fullmatch(r"(\d+)([dwmy])", s.strip().lower())
    if not m:
        raise argparse.ArgumentTypeError("use forms like 90d, 12w, 6m, 1y")
    n, unit = int(m.group(1)), m.group(2)
    return timedelta(days=n * {"d": 1, "w": 7, "m": 30, "y": 365}[unit])


def _valid_str_list(val):
    return isinstance(val, list) and all(isinstance(x, str) for x in val)


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG, encoding="utf-8") as fh:
            user = json.load(fh)
        if not isinstance(user, dict):
            raise ValueError("config must be a JSON object")
        for key, val in user.items():
            if key in ("search_roots", "includes", "exclude_dirs"):
                if not _valid_str_list(val):
                    sys.stderr.write("retire: ignoring bad config %s in %s: expected list of strings\n"
                                     % (key, CONFIG))
                    continue
            elif key == "atime_slack_hours":
                if (isinstance(val, bool) or not isinstance(val, (int, float))
                        or not math.isfinite(val) or val < 0):
                    sys.stderr.write("retire: ignoring bad config %s in %s: expected non-negative number\n"
                                     % (key, CONFIG))
                    continue
            elif key == "default_review_in":
                if not isinstance(val, str):
                    sys.stderr.write("retire: ignoring bad config %s in %s: expected duration string\n"
                                     % (key, CONFIG))
                    continue
                try:
                    _parse_span(val)
                except argparse.ArgumentTypeError as exc:
                    sys.stderr.write("retire: ignoring bad config %s in %s: %s\n"
                                     % (key, CONFIG, exc))
                    continue
            cfg[key] = val
    except FileNotFoundError:
        pass
    except (OSError, ValueError) as exc:
        sys.stderr.write("retire: ignoring bad config %s: %s\n" % (CONFIG, exc))
    env_roots = os.environ.get("RETIRE_SEARCH_ROOTS")
    if env_roots:
        cfg["search_roots"] = [p for p in env_roots.split(os.pathsep) if p]
    return cfg


CFG = load_config()


# ------------------------------------------------------------------- ledger io

@contextlib.contextmanager
def _ledger_lock():
    os.makedirs(STATE, exist_ok=True)
    with open(LOCK, "a+") as fh:
        fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)


def _load():
    if not os.path.exists(LEDGER):
        return []
    with open(LEDGER, encoding="utf-8") as fh:
        return [json.loads(ln) for ln in fh if ln.strip()]


def _save(entries):
    os.makedirs(STATE, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".ledger.", suffix=".tmp", dir=STATE)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            for e in entries:
                fh.write(json.dumps(e) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, LEDGER)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _log(msg):
    os.makedirs(STATE, exist_ok=True)
    with open(LOG, "a", encoding="utf-8", errors="replace") as fh:
        fh.write("%s  %s\n" % (datetime.now().isoformat(timespec="seconds"), msg))


def _find(entries, name):
    for e in entries:
        if e["name"] == name and e["status"] == "retired":
            return e
    sys.exit("no active entry named %r" % name)


def _fmt(ts):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts)) if ts else "?"


def _fmt_size(n):
    """Human-readable decimal byte count (matches GB elsewhere in retire)."""
    n = max(0, int(n or 0))
    for unit, thresh in (("T", 1e12), ("G", 1e9), ("M", 1e6), ("K", 1e3)):
        if n >= thresh:
            v = n / thresh
            return "%.1f%s" % (v, unit) if v < 9.95 else "%.0f%s" % (v, unit)
    return "%dB" % n


# ------------------------------------------------------------------- tripwire

def _tree_scan(path, with_paths=False):
    """Tripwire snapshot: newest atime/mtime/ctime, entry count, total bytes.

    file_atime catches non-directory reads, mtime catches writes, ctime catches
    renames/chmod/chown, and the counts catch additions or deletions inside the
    tree. Symlinks are stat'd with lstat, never followed, and excluded from the
    byte total. Bare directory atimes are recorded for diagnostics/compatibility
    but do not trigger TOUCHED, since scandir and common tools (find, du, rg,
    indexers) bump directory atimes without reading any files.
    """
    snap = {"bytes": 0, "entries": 0, "atime": 0.0, "file_atime": 0.0, "dir_atime": 0.0,
            "mtime": 0.0, "ctime": 0.0, "scanned_at": 0.0, "unreadable": 0}
    paths = {"file_atime": "", "dir_atime": "", "atime": "", "mtime": "", "ctime": ""}
    is_root_dir = [False]

    def rel_label(p):
        if not is_root_dir[0]:
            return ""
        rel = "." if p == path else os.path.relpath(p, path)
        return rel.encode("utf-8", "replace").decode("utf-8")

    def absorb(p, is_top=False):
        try:
            st = os.lstat(p)
        except OSError:
            snap["unreadable"] += 1
            return None
        if is_top:
            is_root_dir[0] = stat.S_ISDIR(st.st_mode)
        snap["entries"] += 1
        if not stat.S_ISLNK(st.st_mode):
            snap["bytes"] += st.st_size
        if stat.S_ISDIR(st.st_mode):
            if st.st_atime > snap["dir_atime"]:
                snap["dir_atime"] = st.st_atime
                if with_paths:
                    paths["dir_atime"] = rel_label(p)
        else:
            if st.st_atime > snap["file_atime"]:
                snap["file_atime"] = st.st_atime
                if with_paths:
                    paths["file_atime"] = rel_label(p)
        for f, _ in TS_FIELDS:
            v = getattr(st, "st_" + f)
            if v > snap[f]:
                snap[f] = v
                if with_paths:
                    paths[f] = rel_label(p)
        return st

    # Never follow a symlink: resolving one updates the link's own atime, which
    # absorb() would then read back as an external read. os.walk() cannot be used
    # here, because it resolves links to classify them even with followlinks=False.
    # Each directory is absorbed before it is listed, and its post-listing atime is
    # recorded via lstat (which does not modify atime) for legacy compatibility.
    top = absorb(path, is_top=True)
    stack = [path] if top is not None and stat.S_ISDIR(top.st_mode) else []
    post_dir_atime = 0.0
    while stack:
        d = stack.pop()
        try:
            with os.scandir(d) as it:
                children = list(it)
        except OSError:
            snap["unreadable"] += 1
            continue
        try:
            post_dir_atime = max(post_dir_atime, os.lstat(d).st_atime)
        except OSError:
            pass
        for ent in children:
            absorb(ent.path)
            try:
                if ent.is_dir(follow_symlinks=False):
                    stack.append(ent.path)
            except OSError:
                snap["unreadable"] += 1
    snap["scanned_at"] = max(post_dir_atime, snap["dir_atime"])
    return (snap, paths) if with_paths else snap


def _baseline_of(e):
    """Baseline snapshot, tolerating entries written by an older version."""
    if e.get("baseline"):
        return e["baseline"]
    if "baseline_atime" in e:
        out = {"atime": e["baseline_atime"]}     # pre-snapshot entry: atime only
        if e.get("scanned_at"):
            out["scanned_at"] = e["scanned_at"]
        return out
    return {}


def _fmt_touch(label, ts, rel, ref_label, ref_ts):
    ctx = ("%s; %s %s" % (rel, ref_label, _fmt(ref_ts))) if rel else ("%s %s" % (ref_label, _fmt(ref_ts)))
    return "TOUCHED: %s at %s (%s)" % (label, _fmt(ts), ctx)


def _drift(e, path):
    """(flags, snapshot) describing how the tree changed since its baseline.

    Only non-directory atimes (files and symlinks) trigger TOUCHED: read, because
    lstat() never bumps them while directory listings (readdir) are constantly
    triggered by find/du/rg, desktop indexers, and our own scan. Writes, renames,
    and additions/deletions inside directories are still caught by mtime, ctime,
    and entry/byte counts.
    """
    base = _baseline_of(e)
    now, paths = _tree_scan(path, with_paths=True)
    out = []
    slack_s = float(CFG["atime_slack_hours"]) * 3600

    if "file_atime" in base or "dir_atime" in base:
        bf = base.get("file_atime")
        if bf is not None and now["file_atime"] > bf + slack_s:
            out.append(_fmt_touch("read", now["file_atime"], paths["file_atime"],
                                  "baseline", bf))
    else:
        b = max(base.get("atime") or 0, base.get("scanned_at") or 0)
        if b and now["file_atime"] > b + slack_s:
            out.append(_fmt_touch("read", now["file_atime"], paths["file_atime"],
                                  "last checked", b))

    for f, label in TS_FIELDS[1:]:
        b = base.get(f)
        if b is None:
            continue
        if now[f] > b:
            out.append(_fmt_touch(label, now[f], paths[f], "baseline", b))
    for f, label in (("entries", "entry count"), ("bytes", "total bytes")):
        b = base.get(f)
        if b is not None and now[f] != b:
            out.append("DRIFT: %s %s -> %s" % (label, b, now[f]))
    if now.get("unreadable"):
        out.append("UNVERIFIED: could not scan %d unreadable path(s) inside retired tree"
                   % now["unreadable"])
    if not base:
        out.append("NO BASELINE (entry predates snapshots; run: retire rebaseline %s)" % e["name"])
    return out, now


# -------------------------------------------------------------- reference scan

def _real(p):
    """p with the symlinks in its parent resolved, but not p itself."""
    p = os.path.abspath(_fspath(p))
    return os.path.join(os.path.realpath(os.path.dirname(p)), os.path.basename(p))


def _grep_operands(skip_paths):
    """(operands, issues) covering every search root except skip_paths.

    grep must not enter a retired path: listing its directories and reading its files
    updates their atimes, which review then reports as reads. grep's --exclude-dir
    matches base names, so it would also skip any live directory that happens to share
    a retired path's name. Instead, the directories on the way down to a skipped path
    are listed here and their other children are handed to grep one by one, filtered
    as grep -r filters what it finds: symlinks are not followed, exclude_dirs are
    skipped and files must match includes. Nothing inside a skipped path is opened.
    Any missing root or unreadable directory is recorded in `issues` so the caller
    reports UNVERIFIED instead of silently treating a failed scan as clean.
    """
    configured = CFG["search_roots"]
    if not configured:
        return None, ["no search_roots configured"]
    roots, issues = [], []
    for r in configured:
        fr = _fspath(r)
        if os.path.isdir(fr):
            roots.append(fr)
        else:
            issues.append("missing search root: %s" % r)
    if not roots:
        return None, issues
    skip = set(_real(p) for p in skip_paths)
    above = set()                       # real directories that hold a skipped path
    for p in skip:
        d = os.path.dirname(p)
        while d not in above:
            above.add(d)
            d = os.path.dirname(d)

    def matches(name, globs):
        return any(fnmatchcase(name, g) for g in globs)

    ops = []

    def expand(shown, real):
        try:
            with os.scandir(shown) as it:
                children = list(it)
        except OSError as exc:
            issues.append("cannot read %s: %s" % (shown, exc.strerror or exc))
            return
        for ent in children:
            child = os.path.join(real, ent.name)
            try:
                if child in skip or ent.is_symlink():
                    continue
                if ent.is_dir(follow_symlinks=False):
                    if matches(ent.name, CFG["exclude_dirs"]):
                        continue
                    if child in above:
                        expand(ent.path, child)
                    else:
                        ops.append(ent.path)
                elif ent.is_file(follow_symlinks=False):
                    if not CFG["includes"] or matches(ent.name, CFG["includes"]):
                        ops.append(ent.path)
            except OSError as exc:
                issues.append("cannot inspect %s: %s" % (ent.path, exc.strerror or exc))
                continue

    for root in roots:
        real = os.path.realpath(root)
        if any(real == s or real.startswith(s + os.sep) for s in skip):
            continue
        if real in above:
            expand(root, real)
        else:
            ops.append(root)
    return ops, issues


def _batches(paths, limit=64 * 1024):
    """Split grep operands so that each command line stays far below ARG_MAX."""
    batch, size = [], 0
    for p in paths:
        n = len(os.fsencode(p)) + 1
        if batch and size + n > limit:
            yield batch
            batch, size = [], 0
        batch.append(p)
        size += n
    if batch:
        yield batch


def _add_issue(issues, msg):
    if msg not in issues:
        issues.append(msg)


def _grep_refs(name, operands_result):
    """(hits, issues) for files still mentioning `name`.

    `operands_result` comes from _grep_operands(). Advisory only -- prose mentions
    count too. `issues` is non-empty whenever the check could not complete cleanly.
    """
    operands, op_issues = operands_result
    issues = list(op_issues)
    if operands is None:
        return [], issues    # no search root: grep with no path operands reads stdin
    cmd = ["grep", "-rlFw", "--binary-files=without-match"]
    for inc in CFG["includes"]:
        cmd.append("--include=" + inc)
    for ex in CFG["exclude_dirs"]:
        cmd.append("--exclude-dir=" + ex)
    cmd += ["-e", _fspath(name), "--"]
    hits, seen, deadline = [], set(), time.time() + 180
    for batch in _batches(operands):
        rem = deadline - time.time()
        if rem <= 0:
            _add_issue(issues, "grep timed out")
            break
        try:
            proc = subprocess.run(cmd + batch, capture_output=True,
                                  stdin=subprocess.DEVNULL, timeout=rem)
        except subprocess.TimeoutExpired:
            _add_issue(issues, "grep timed out")
            break
        except OSError as exc:
            _add_issue(issues, "grep unavailable: %s" % (exc.strerror or exc))
            break
        for raw_ln in proc.stdout.splitlines():
            s = raw_ln.rstrip(b"\r\n").decode("utf-8", "replace")
            if s and s not in seen:
                seen.add(s)
                hits.append(s)
        if proc.returncode not in (0, 1):
            err_text = (proc.stderr or b"").decode("utf-8", "replace").strip()
            err_lines = err_text.splitlines()
            detail = err_lines[0] if err_lines else ("exit status %d" % proc.returncode)
            _add_issue(issues, "grep failed (%s)" % detail)
    return hits, issues


def _grep_refs_many(names, operands_result):
    """(refs_by_name, issues) for files still mentioning each name in `names`.

    Runs one recursive grep across all names to find candidate files, then attributes
    only those candidate files back to individual names. Avoids walking search_roots
    once per active entry when several entries are retired.
    """
    operands, op_issues = operands_result
    issues = list(op_issues)
    unique = list(dict.fromkeys(names))
    if not unique:
        return {}, issues
    if operands is None:
        return {n: [] for n in unique}, issues
    if len(unique) == 1:
        hits, single_issues = _grep_refs(unique[0], operands_result)
        return {unique[0]: hits}, single_issues

    # Stage 1: one recursive pass per pattern batch to find files mentioning ANY name.
    # Capture stdout as raw bytes and round-trip paths via os.fsdecode so non-UTF-8
    # filenames still open cleanly in Stage 2 before decoding display strings with replace.
    base_cmd = ["grep", "-rlFw", "--binary-files=without-match"]
    for inc in CFG["includes"]:
        base_cmd.append("--include=" + inc)
    for ex in CFG["exclude_dirs"]:
        base_cmd.append("--exclude-dir=" + ex)

    candidates, seen = [], set()
    deadline = time.time() + 180
    aborted = False
    for name_batch in _batches(unique, limit=16 * 1024):
        pat_args = []
        for n in name_batch:
            pat_args += ["-e", _fspath(n)]
        cmd = base_cmd + pat_args + ["--"]
        for batch in _batches(operands):
            rem = deadline - time.time()
            if rem <= 0:
                _add_issue(issues, "grep timed out")
                aborted = True
                break
            try:
                proc = subprocess.run(cmd + batch, capture_output=True,
                                      stdin=subprocess.DEVNULL, timeout=rem)
            except subprocess.TimeoutExpired:
                _add_issue(issues, "grep timed out")
                aborted = True
                break
            except OSError as exc:
                _add_issue(issues, "grep unavailable: %s" % (exc.strerror or exc))
                aborted = True
                break
            for raw_ln in proc.stdout.splitlines():
                raw_path = raw_ln.rstrip(b"\r\n")
                if raw_path and raw_path not in seen:
                    seen.add(raw_path)
                    candidates.append(os.fsdecode(raw_path))
            if proc.returncode not in (0, 1):
                err_text = (proc.stderr or b"").decode("utf-8", "replace").strip()
                err_lines = err_text.splitlines()
                detail = err_lines[0] if err_lines else ("exit status %d" % proc.returncode)
                _add_issue(issues, "grep failed (%s)" % detail)
        if aborted:
            break

    result = {n: [] for n in unique}
    if not candidates or aborted:
        return result, issues

    # Stage 2: attribute only the matching candidate files to each name (no -r walk).
    for n in unique:
        cmd = ["grep", "-lFw", "--binary-files=without-match", "-e", _fspath(n), "--"]
        hits, hit_seen = [], set()
        for batch in _batches(candidates):
            rem = deadline - time.time()
            if rem <= 0:
                _add_issue(issues, "grep timed out")
                aborted = True
                break
            try:
                proc = subprocess.run(cmd + batch, capture_output=True,
                                      stdin=subprocess.DEVNULL, timeout=rem)
            except subprocess.TimeoutExpired:
                _add_issue(issues, "grep timed out")
                aborted = True
                break
            except OSError as exc:
                _add_issue(issues, "grep unavailable: %s" % (exc.strerror or exc))
                aborted = True
                break
            for raw_ln in proc.stdout.splitlines():
                s = raw_ln.rstrip(b"\r\n").decode("utf-8", "replace")
                if s and s not in hit_seen:
                    hit_seen.add(s)
                    hits.append(s)
            if proc.returncode not in (0, 1):
                err_text = (proc.stderr or b"").decode("utf-8", "replace").strip()
                err_lines = err_text.splitlines()
                detail = err_lines[0] if err_lines else ("exit status %d" % proc.returncode)
                _add_issue(issues, "grep failed (%s)" % detail)
        result[n] = hits
        if aborted:
            break
    return result, issues


# -------------------------------------------------------------- notification

def _notify_darwin(title, body):
    flat = " / ".join(ln.strip() for ln in body.splitlines() if ln.strip())
    if shutil.which("terminal-notifier"):
        msg = (" " + flat) if flat.startswith("-") else flat
        subprocess.run(["terminal-notifier", "-title", title, "-message", msg],
                       timeout=20, check=True, capture_output=True, text=True)
        return True
    if shutil.which("osascript"):
        def esc(s):
            return s.replace("\\", "\\\\").replace('"', '\\"')
        subprocess.run(["osascript", "-e", 'display notification "%s" with title "%s"'
                        % (esc(flat), esc(title))],
                       timeout=20, check=True, capture_output=True, text=True)
        return True
    return False


def _notify_linux(title, body, urgency):
    if not shutil.which("notify-send"):
        return False
    env = dict(os.environ)
    # cron supplies no session environment; guess the usual systemd/X11 values.
    env.setdefault("DISPLAY", ":0")
    if hasattr(os, "getuid"):
        env.setdefault("DBUS_SESSION_BUS_ADDRESS",
                       "unix:path=/run/user/%d/bus" % os.getuid())
    subprocess.run(["notify-send", "-u", urgency, "-a", "retire", "--", title, body],
                   env=env, timeout=20, check=True, capture_output=True, text=True)
    return True


def notify(title, body, urgency="normal"):
    system = platform.system()
    try:
        if system == "Darwin":
            ok = _notify_darwin(title, body)
        elif system == "Linux":
            ok = _notify_linux(title, body, urgency)
        else:
            ok = False
    except subprocess.CalledProcessError as exc:   # a desktop may simply not be up
        detail = (exc.stderr or exc.stdout or "").strip() or str(exc)
        _log("notification failed: %s" % detail)
        return False
    except Exception as exc:
        _log("notification failed: %s" % exc)
        return False
    if not ok:
        _log("no notifier available on %s; verdict written to %s only" % (system, LOG))
    return ok


# ---------------------------------------------------------------- ledger verbs

def _resolve_target(raw, verb):
    if not raw or "\0" in raw:
        sys.exit("invalid path: %r" % raw)
    stripped = raw.rstrip(os.sep)
    if not stripped:
        sys.exit("refusing to %s filesystem root: %s" % (verb, raw))
    path = os.path.abspath(stripped)
    if path == os.sep:
        sys.exit("refusing to %s filesystem root: %s" % (verb, raw))
    return path


def _validate_name(name):
    bad_chars = (os.sep, "\0", "\n", "\r") + ((os.altsep,) if os.altsep else ())
    if not name or name in (".", "..") or any(c in name for c in bad_chars):
        sys.exit("invalid entry name: %r (must be a single non-empty filename component)" % name)
    return name


def _contains_state(path):
    """True if moving `path` would relocate or break retire's own STATE directory."""
    src_abs = os.path.abspath(path)
    state_abs = os.path.abspath(STATE)
    if state_abs == src_abs or state_abs.startswith(src_abs + os.sep):
        return True
    if os.path.isdir(path) and not os.path.islink(path):
        src_real = _real(path)
        state_real = os.path.realpath(STATE)
        if state_real == src_real or state_real.startswith(src_real + os.sep):
            return True
    return False


def _name_taken(entries, name):
    return any(x["name"] == name and x["status"] == "retired" for x in entries)


def _record(original_path, retired_path, reason, review_in, name=None):
    name = _validate_name(name if name is not None else os.path.basename(original_path))
    snap = _tree_scan(retired_path)
    entry = {
        "name": name,
        "original_path": original_path,
        "retired_path": retired_path,
        "retired_on": date.today().isoformat(),
        "review_after": (date.today() + review_in).isoformat(),
        "bytes": snap["bytes"],
        "reason": reason,
        "baseline": snap,
        "acked_refs": [],
        "status": "retired",
    }
    with _ledger_lock():
        entries = _load()
        if _name_taken(entries, name):
            sys.exit("already an active ledger entry named %r" % name)
        entries.append(entry)
        _save(entries)
    return entry


def cmd_put(a):
    src = _resolve_target(a.path, "retire")
    if not os.path.lexists(src):
        sys.exit("no such path: %s" % src)
    if _contains_state(src):
        sys.exit("refusing to retire path containing retire state directory (%s): %s"
                 % (STATE, src))
    name = _validate_name(os.path.basename(src))
    # Entries are named after the basename. Refuse a taken name before anything moves:
    # checking only inside _record, after the rename, left the path renamed but unrecorded.
    if _name_taken(_load(), name):
        sys.exit("already an active ledger entry named %r; nothing was moved" % name)
    dst = "%s.RETIRED.%s" % (src, date.today().strftime("%Y%m%d"))
    if os.path.lexists(dst):
        sys.exit("target already exists: %s" % dst)
    try:
        os.rename(src, dst)                      # same fs -> atomic, no copy
    except OSError as exc:
        sys.exit("could not rename %s: %s" % (src, exc))
    try:
        e = _record(src, dst, a.reason, a.review_in)
    except BaseException as exc:
        # Any failure to record (ledger unwritable, a racing put, Ctrl-C during the scan)
        # must not leave a rename the ledger does not know about: move it back first,
        # without clobbering anything recreated at src in the meantime.
        if os.path.lexists(src):
            sys.exit("could not record %s (%s) and %s is now occupied; retired copy is at %s"
                     % (src, exc, src, dst))
        try:
            os.rename(dst, src)
        except OSError as back:
            sys.exit("could not record %s (%s) and could not move it back (%s); it is at %s"
                     % (src, exc, back, dst))
        if isinstance(exc, OSError):
            sys.exit("could not record %s: %s; moved it back, nothing changed" % (src, exc))
        raise
    print("retired %s -> %s (%.1f GB, review after %s)"
          % (src, dst, e["bytes"] / 1e9, e["review_after"]))


def cmd_adopt(a):
    dst = _resolve_target(a.retired_path, "adopt")
    if not os.path.lexists(dst):
        sys.exit("no such path: %s" % dst)
    raw_name = a.name if a.name is not None else re.sub(r"\.RETIRED\.\d{8}$", "", os.path.basename(dst))
    name = _validate_name(raw_name)
    original = os.path.join(os.path.dirname(dst), name)
    e = _record(original, dst, a.reason, a.review_in, name=name)
    print("adopted %s as %r (%.1f GB, review after %s)"
          % (dst, name, e["bytes"] / 1e9, e["review_after"]))


def _sort_entries(items, key_name):
    if key_name == "size":
        return sorted(items, key=lambda e: (-(e.get("bytes") or 0), e["name"]))
    if key_name == "retired":
        return sorted(items, key=lambda e: (e.get("retired_on", ""), e["name"]))
    if key_name == "name":
        return sorted(items, key=lambda e: (e["name"].lower(), e["name"]))
    return sorted(items, key=lambda e: (e.get("review_after", ""), e.get("retired_on", ""), e["name"]))


def cmd_list(a):
    entries = _load()
    if not entries:
        print("[]" if a.json else "ledger is empty")
        return

    today = date.today().isoformat()
    active = [e for e in entries if e["status"] == "retired"]
    historical = len(entries) - len(active)

    if a.all:
        rows = list(entries)
    elif a.due:
        rows = [e for e in active if today >= e["review_after"]]
    else:
        rows = list(active)

    if not rows:
        if a.json:
            print("[]")
        elif a.due:
            print("nothing due for review (%d active holding)" % len(active)
                  if active else "nothing retired")
        else:
            print("nothing retired (%d historical; use --all to show)" % historical)
        return

    if a.all:
        act = _sort_entries([e for e in rows if e["status"] == "retired"], a.sort)
        hist = [e for e in rows if e["status"] != "retired"]
        if a.sort == "review":
            hist.sort(key=lambda e: (
                e.get("purged_on") or e.get("restored_on") or e.get("retired_on", ""),
                e["name"],
            ), reverse=True)
        else:
            hist = _sort_entries(hist, a.sort)
        rows = act + hist
    else:
        rows = _sort_entries(rows, a.sort)

    if a.json:
        print(json.dumps(rows, indent=2))
        return

    show_hits = any(e.get("events") for e in rows)
    table = []
    for e in rows:
        if e["status"] == "retired":
            st = "DUE" if today >= e["review_after"] else "holding"
        else:
            st = e["status"]
        hits = str(len(e["events"])) if e.get("events") else "-"
        reason = " ".join((e.get("reason") or "").split())
        table.append((e["name"], st, hits, e.get("retired_on", "?"),
                      e.get("review_after", "?"), _fmt_size(e.get("bytes")),
                      reason, e))

    w_name = max(4, max(len(r[0]) for r in table))
    w_stat = max(6, max(len(r[1]) for r in table))
    w_hits = max(4, max(len(r[2]) for r in table))
    w_size = max(4, max(len(r[5]) for r in table))

    if show_hits:
        fmt = "%%-%ds  %%-%ds  %%%ds  %%-10s  %%-10s  %%%ds  %%s" % (w_name, w_stat, w_hits, w_size)
        prefix_w = w_name + 2 + w_stat + 2 + w_hits + 2 + 10 + 2 + 10 + 2 + w_size + 2
        print((fmt % ("NAME", "STATUS", "HITS", "RETIRED", "REVIEW", "SIZE", "REASON")).rstrip())
    else:
        fmt = "%%-%ds  %%-%ds  %%-10s  %%-10s  %%%ds  %%s" % (w_name, w_stat, w_size)
        prefix_w = w_name + 2 + w_stat + 2 + 10 + 2 + 10 + 2 + w_size + 2
        print((fmt % ("NAME", "STATUS", "RETIRED", "REVIEW", "SIZE", "REASON")).rstrip())

    truncate = not a.full and (sys.stdout.isatty() or "COLUMNS" in os.environ)
    max_reason = None
    if truncate:
        cols = shutil.get_terminal_size((100, 24)).columns
        max_reason = max(16, cols - prefix_w)

    for name, st, hits, ret, rev, sz, reason, e in table:
        if max_reason is not None and len(reason) > max_reason:
            reason = reason[:max_reason - 3].rstrip() + "..."
        if show_hits:
            line = fmt % (name, st, hits, ret, rev, sz, reason)
        else:
            line = fmt % (name, st, ret, rev, sz, reason)
        print(line.rstrip())
        if a.full:
            if e["status"] == "retired":
                print("    path: %s" % e["retired_path"])
            else:
                done = e.get("purged_on") or e.get("restored_on") or "?"
                print("    path: %s (%s on %s)" % (e["original_path"], e["status"], done))
            for x in e.get("events") or []:
                print("    hit (%s): %s" % (x.get("seen", "?"), x.get("flag", "")))

    if sys.stdout.isatty():
        due_n = sum(1 for e in active if today >= e["review_after"])
        act_sz = _fmt_size(sum(e.get("bytes") or 0 for e in active))
        if a.all:
            print("\n%d active (%d due, %s), %d historical"
                  % (len(active), due_n, act_sz, historical))
        elif a.due:
            due_sz = _fmt_size(sum(e.get("bytes") or 0 for e in rows))
            print("\n%d due (%s); %d holding" % (len(rows), due_sz, len(active) - len(rows)))
        else:
            tail = "; %d historical hidden (--all to show)" % historical if historical else ""
            print("\n%d active (%d due, %s)%s" % (len(active), due_n, act_sz, tail))


def _commit_review_updates(updates):
    """Merge review bookkeeping updates into the ledger under lock."""
    with _ledger_lock():
        fresh = _load()
        for fe in fresh:
            if fe["status"] != "retired":
                continue
            key = (fe["name"], fe["retired_path"])
            if key not in updates:
                continue
            orig_base, new_scanned_at, new_events = updates[key]
            cur_base = _baseline_of(fe)
            rebaselined = (
                cur_base.get("mtime") != orig_base.get("mtime")
                or cur_base.get("ctime") != orig_base.get("ctime")
                or cur_base.get("entries") != orig_base.get("entries")
                or cur_base.get("bytes") != orig_base.get("bytes")
                or cur_base.get("file_atime") != orig_base.get("file_atime")
                or (cur_base.get("scanned_at") or 0) > (orig_base.get("scanned_at") or 0)
            )
            if rebaselined:
                continue
            if new_events:
                rem = fe.setdefault("events", [])
                known = set(x["flag"] for x in rem)
                for ev in new_events:
                    if ev["flag"] not in known:
                        rem.append(ev)
                        known.add(ev["flag"])
            if new_scanned_at is not None:
                if isinstance(fe.get("baseline"), dict):
                    fe["baseline"]["scanned_at"] = max(
                        fe["baseline"].get("scanned_at") or 0, new_scanned_at)
                elif "baseline_atime" in fe:
                    fe["scanned_at"] = max(fe.get("scanned_at") or 0, new_scanned_at)
        _save(fresh)


def cmd_review(a):
    if a.due and a.names:
        sys.exit("cannot combine --due with explicit entry names")
    entries = _load()
    active = [e for e in entries if e["status"] == "retired"]
    if not active and not a.names:
        print("nothing retired")
        return 0
    today, alerts = date.today(), []

    if a.names:
        targets, seen = [], set()
        for name in a.names:
            e = _find(entries, name)
            if e["name"] not in seen:
                seen.add(e["name"])
                targets.append(e)
    elif a.due:
        targets = [e for e in active if today.isoformat() >= e["review_after"]]
        if not targets:
            print("nothing due for review")
            return 0
    else:
        targets = active

    # Scan every targeted tree before running any reference check. grep reads directories
    # and files under the search roots, so a tree scanned after a grep could see that grep
    # as a read; _grep_operands() also keeps grep out of every active retired path (even
    # untargeted ones). lexists, because exists() would resolve a retired symlink and
    # update its atime. Persist scanned_at even if interrupted mid-run so an aborted scan
    # never poisons the next review.
    scans, updates, committed = [], {}, False
    try:
        for e in targets:
            rpath = _fspath(e["retired_path"])
            if os.path.lexists(rpath):
                tripped, snap = _drift(e, rpath)
            else:
                tripped, snap = ["MISSING (moved or deleted outside this tool)"], None
            scans.append((tripped, snap))
            updates[(e["name"], e["retired_path"])] = (
                dict(_baseline_of(e)),
                snap["scanned_at"] if snap is not None else None,
                [],
            )
        operands = _grep_operands([e["retired_path"] for e in active])
        refs_by_name, ref_issues = _grep_refs_many([e["name"] for e in targets], operands)

        for e, (tripped, snap) in zip(targets, scans):
            flags = list(tripped)
            found = refs_by_name.get(e["name"], [])
            refs = [r for r in found if r not in set(e.get("acked_refs", []))]
            if refs:
                flags.append("REFERENCED in %d new file(s): %s"
                             % (len(refs), ", ".join(refs[:3]) + (" ..." if len(refs) > 3 else "")))
            if ref_issues:
                flags.append("UNVERIFIED: reference check could not complete (%s)"
                             % "; ".join(ref_issues))
            due = today.isoformat() >= e["review_after"]
            if due:
                flags.append("DUE (review date %s passed)" % e["review_after"])

            remembered = list(e.get("events", []))
            known = set(x["flag"] for x in remembered)
            new_events = []
            for f in flags:
                if f.startswith(("TOUCHED", "DRIFT")) and f not in known:
                    ev = {"seen": today.isoformat(), "flag": f}
                    remembered.append(ev)
                    new_events.append(ev)
                    known.add(f)
            earlier = [x for x in remembered if x["flag"] not in flags]

            updates[(e["name"], e["retired_path"])] = (
                dict(_baseline_of(e)),
                snap["scanned_at"] if snap is not None else None,
                new_events,
            )

            serious = ("TOUCHED", "DRIFT", "REFERENCED", "MISSING", "NO BASELINE", "UNVERIFIED")
            if any(f.startswith(serious) for f in flags) or earlier:
                verdict = "INVESTIGATE"
            elif due:
                verdict = "SAFE TO PURGE"
            else:
                verdict = "holding"

            line = "%s [%s] %.1f GB" % (e["name"], verdict, e["bytes"] / 1e9)
            print(line)
            for f in flags:
                print("    - %s" % f)
            for x in earlier:
                print("    - EARLIER (%s): %s" % (x["seen"], x["flag"]))
            _log(line + ("; " + "; ".join(flags) if flags else ""))
            if verdict != "holding":
                alerts.append((e, verdict))

        _commit_review_updates(updates)
        committed = True
    except BaseException:
        if updates and not committed:
            try:
                _commit_review_updates(updates)
            except OSError:
                pass
        raise

    if a.notify and alerts:
        body = "\n".join("%s: %s" % (e["name"], v) for e, v in alerts)
        body += "\n\nrun: retire review   /   retire purge <name> --yes"
        notify("retire: %d item(s) need attention" % len(alerts), body,
               urgency="critical" if any(v == "INVESTIGATE" for _, v in alerts) else "normal")
    return 1 if alerts else 0


def cmd_ack(a):
    entries = _load()
    e = _find(entries, a.name)
    refs, issues = _grep_refs(e["name"], _grep_operands(
        [x["retired_path"] for x in entries if x["status"] == "retired"]))
    if issues:
        sys.exit("reference check could not complete (%s); nothing acked" % "; ".join(issues))
    with _ledger_lock():
        entries = _load()
        e = _find(entries, a.name)
        e["acked_refs"] = sorted(set(e.get("acked_refs", [])) | set(refs))
        _save(entries)
        acked = list(e["acked_refs"])
    print("acknowledged %d reference(s) for %r:" % (len(refs), a.name))
    for r in acked:
        print("    %s" % r)
    print("review will now flag only references that appear after this point.")


def cmd_rebaseline(a):
    if a.all and a.names:
        sys.exit("cannot combine --all with explicit entry names")
    if not a.all and not a.names:
        sys.exit("specify one or more entry names, or --all")
    entries = _load()
    if a.all:
        targets = [e for e in entries if e["status"] == "retired"]
        if not targets:
            print("nothing retired")
            return 0
    else:
        targets, seen = [], set()
        for name in a.names:
            e = _find(entries, name)
            if e["name"] not in seen:
                seen.add(e["name"])
                targets.append(e)

    snaps, skipped = {}, 0
    for e in targets:
        if not os.path.lexists(e["retired_path"]):
            if a.all:
                sys.stderr.write("retire: skipping missing path for %r: %s\n"
                                 % (e["name"], e["retired_path"]))
                skipped += 1
                continue
            sys.exit("retired path is missing: %s" % e["retired_path"])
        snaps[(e["name"], e["retired_path"])] = _tree_scan(e["retired_path"])

    if not snaps:
        return 1 if skipped else 0

    results = []
    with _ledger_lock():
        fresh = _load()
        for e in targets:
            key = (e["name"], e["retired_path"])
            if key not in snaps:
                continue
            fe = next((x for x in fresh
                       if x["name"] == e["name"] and x["status"] == "retired"), None)
            if fe is None:
                continue
            if not os.path.lexists(fe["retired_path"]):
                if a.all:
                    sys.stderr.write("retire: skipping missing path for %r: %s\n"
                                     % (fe["name"], fe["retired_path"]))
                    skipped += 1
                    continue
                sys.exit("retired path is missing: %s" % fe["retired_path"])
            snap = snaps[key]
            old = _baseline_of(fe)
            cleared = len(fe.get("events", []))
            fe["baseline"] = snap
            fe["bytes"] = snap["bytes"]
            fe.pop("baseline_atime", None)
            fe.pop("scanned_at", None)
            fe["events"] = []
            results.append((fe["name"], old, snap, cleared))
        _save(fresh)

    for name, old, snap, cleared in results:
        print("rebaselined %r%s" % (name, " (cleared %d remembered hit(s))" % cleared if cleared else ""))
        for f, _ in TS_FIELDS:
            old_ts = old.get("file_atime") if f == "atime" and "file_atime" in old else old.get(f)
            new_ts = snap["file_atime"] if f == "atime" else snap[f]
            print("    %-6s %s -> %s" % (f, _fmt(old_ts), _fmt(new_ts)))
        print("    %-6s %s entries, %s bytes"
              % ("size", snap["entries"], snap["bytes"]))
    return 1 if skipped else 0


def cmd_restore(a):
    try:
        with _ledger_lock():
            entries = _load()
            e = _find(entries, a.name)
            retired_path, original_path = e["retired_path"], e["original_path"]
            if not os.path.lexists(retired_path):
                sys.exit("retired path is missing: %s" % retired_path)
            if retired_path == original_path:
                sys.exit("cannot restore %r: adopted in place (original path equals retired path: %s)"
                         % (a.name, retired_path))
            if os.path.lexists(original_path):
                sys.exit("original path is occupied: %s" % original_path)
            try:
                os.rename(retired_path, original_path)
            except OSError as exc:
                sys.exit("could not restore %s: %s" % (retired_path, exc))
            try:
                e["status"] = "restored"
                e["restored_on"] = date.today().isoformat()
                _save(entries)
            except BaseException as exc:
                if os.path.lexists(retired_path):
                    sys.exit("could not update ledger (%s) and %s is now occupied; restored copy is at %s"
                             % (exc, retired_path, original_path))
                try:
                    os.rename(original_path, retired_path)
                except OSError as back:
                    sys.exit("could not update ledger (%s) and could not move %s back (%s); it is at %s"
                             % (exc, original_path, back, original_path))
                if isinstance(exc, OSError):
                    sys.exit("could not update ledger: %s; moved it back, nothing changed" % exc)
                raise
    except OSError as exc:
        sys.exit("could not lock ledger: %s; nothing changed" % exc)
    print("restored %s -> %s" % (retired_path, original_path))


def cmd_purge(a):
    if not a.yes:
        e = _find(_load(), a.name)
        sys.exit("would delete %s (%.1f GB). Re-run with --yes to confirm."
                 % (e["retired_path"], e["bytes"] / 1e9))
    try:
        with _ledger_lock():
            entries = _load()
            e = _find(entries, a.name)
            retired_path = e["retired_path"]
            if not os.path.lexists(retired_path):
                sys.exit("retired path is missing: %s" % retired_path)
            print("deleting %s (%.1f GB) ..." % (retired_path, e["bytes"] / 1e9))
            try:
                if os.path.isdir(retired_path) and not os.path.islink(retired_path):
                    shutil.rmtree(retired_path)
                else:
                    os.remove(retired_path)      # put also accepts single files
            except OSError as exc:
                sys.exit("could not delete %s: %s" % (retired_path, exc))
            e["status"] = "purged"
            e["purged_on"] = date.today().isoformat()
            try:
                _save(entries)
            except OSError as exc:
                sys.exit("deleted %s, but could not update ledger: %s" % (retired_path, exc))
    except OSError as exc:
        sys.exit("could not lock ledger: %s; nothing deleted" % exc)
    _log("PURGED %s" % retired_path)
    print("done")


def cmd_doctor(a):
    system = platform.system()
    active = [e for e in _load() if e["status"] == "retired"]
    print("retire %s" % __version__)
    print("  platform        %s %s" % (system, platform.release()))
    print("  python          %s (%s)" % (platform.python_version(), sys.executable))
    print("  config          %s%s"
          % (CONFIG, "" if os.path.exists(CONFIG) else "   [absent, using defaults]"))
    print("  state dir       %s" % STATE)
    print("  ledger          %s   [%d active]" % (LEDGER, len(active)))

    if system == "Darwin":
        tool = ("terminal-notifier" if shutil.which("terminal-notifier")
                else "osascript" if shutil.which("osascript") else None)
    elif system == "Linux":
        tool = "notify-send" if shutil.which("notify-send") else None
    else:
        tool = None
    print("  notifier        %s" % (tool or "NONE  [verdicts logged only]"))

    grep = shutil.which("grep")
    print("  grep            %s" % (grep or "NONE  [reference check disabled]"))

    roots = CFG["search_roots"]
    if not roots:
        print("  search roots    none configured  [reference check reports UNVERIFIED]")
    for r in roots:
        print("  search root     %s%s" % (r, "" if os.path.isdir(_fspath(r)) else "   [MISSING]"))
    print("  atime slack     %s h" % CFG["atime_slack_hours"])
    print("  default review  %s" % CFG["default_review_in"])


