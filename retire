def _default_review_span():
    raw = CFG.get("default_review_in", DEFAULTS["default_review_in"])
    try:
        return _parse_span(str(raw))
    except argparse.ArgumentTypeError as exc:
        sys.stderr.write("retire: ignoring bad default_review_in %r in %s: %s\n"
                         % (raw, CONFIG, exc))
        return _parse_span(DEFAULTS["default_review_in"])


def build_parser():
    ap = argparse.ArgumentParser(
        prog="retire", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="full documentation: man retire")
    ap.add_argument("--version", action="version", version="retire " + __version__)
    sub = ap.add_subparsers(dest="cmd")
    P = {}
    span = _default_review_span()

    p = sub.add_parser("put", help="rename a path aside and record it")
    p.add_argument("path")
    p.add_argument("--reason", default="")
    p.add_argument("--review-in", type=_parse_span, default=span)
    p.set_defaults(func=cmd_put); P["put"] = p

    p = sub.add_parser("adopt", help="record a path that was already moved aside")
    p.add_argument("retired_path")
    p.add_argument("--name", default=None)
    p.add_argument("--reason", default="")
    p.add_argument("--review-in", type=_parse_span, default=span)
    p.set_defaults(func=cmd_adopt); P["adopt"] = p

    p = sub.add_parser("list", help="show active pipeline (or full ledger with --all)")
    g = p.add_mutually_exclusive_group()
    g.add_argument("-a", "--all", action="store_true",
                   help="include purged and restored entries")
    g.add_argument("--due", action="store_true",
                   help="show only active entries whose review date has passed")
    p.add_argument("--sort", choices=("review", "retired", "size", "name"),
                   default="review", help="sort order (default: review)")
    p.add_argument("--full", action="store_true",
                   help="do not truncate reasons and include paths and hits")
    p.add_argument("--json", action="store_true",
                   help="output matching entries as JSON")
    p.set_defaults(func=cmd_list); P["list"] = p

    p = sub.add_parser("review", help="read-only safety check")
    p.add_argument("names", nargs="*", metavar="name",
                   help="check only these active entries (default: all active)")
    p.add_argument("--due", action="store_true",
                   help="check only active entries whose review date has passed")
    p.add_argument("--notify", action="store_true",
                   help="send a desktop notification when items need attention")
    p.set_defaults(func=cmd_review); P["review"] = p

    p = sub.add_parser("ack", help="accept current references as known")
    p.add_argument("name"); p.set_defaults(func=cmd_ack); P["ack"] = p

    p = sub.add_parser("rebaseline", help="reset the tripwire snapshot")
    p.add_argument("names", nargs="*", metavar="name",
                   help="active entry names to rebaseline")
    p.add_argument("--all", action="store_true",
                   help="rebaseline all active entries")
    p.set_defaults(func=cmd_rebaseline); P["rebaseline"] = p

    p = sub.add_parser("restore", help="move it back")
    p.add_argument("name"); p.set_defaults(func=cmd_restore); P["restore"] = p

    p = sub.add_parser("purge", help="actually delete it")
    p.add_argument("name"); p.add_argument("--yes", action="store_true")
    p.set_defaults(func=cmd_purge); P["purge"] = p

    p = sub.add_parser("doctor", help="report the local setup")
    p.set_defaults(func=cmd_doctor); P["doctor"] = p

    return ap, P


def main():
    ap, parsers = build_parser()
    argv = sys.argv[1:]

    # `retire`, `retire ?`, `retire help [cmd]` -> documentation rather than an error.
    if not argv or argv[0] in ("?", "help", "h", "-h", "--help"):
        topic = argv[1] if len(argv) > 1 else None
        (parsers[topic] if topic in parsers else ap).print_help()
        return 0
    if not argv[0].startswith("-") and argv[0] not in parsers:
        sys.stderr.write("retire: unknown command %r\n\n" % argv[0])
        ap.print_help()
        return 2

    a = ap.parse_args(argv)
    return a.func(a) or 0


if __name__ == "__main__":
    try:
        rc = main()
        sys.stdout.flush()
        sys.exit(rc)
    except BrokenPipeError:
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            try:
                os.dup2(devnull, sys.stdout.fileno())
            finally:
                os.close(devnull)
        except OSError:
            pass
        sys.exit(128 + getattr(signal, "SIGPIPE", 13))
